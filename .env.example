# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Database (MySQL, used by Drizzle ORM) ----
DATABASE_URL=mysql://user:password@localhost:3306/bracelets_db

# ---- Local auth (owner/admin login at /login + employee login), JWT sessions ----
JWT_SECRET=replace-with-a-long-random-string

# ---- First owner/admin account (used only by `pnpm seed:admin`) ----
# Only needed once, to bootstrap the first admin account. See scripts/seed-admin.ts —
# it's a no-op if an admin/manager account already exists.
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_EMAIL=owner@example.com

# ---- Manus Forge storage (file upload/download proxy) ----
BUILT_IN_FORGE_API_URL=https://your-forge-storage.example.com
BUILT_IN_FORGE_API_KEY=replace-with-forge-api-key

# ---- Bosta shipping integration ----
BOSTA_API_KEY=replace-with-bosta-api-key
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_PICKUP_ADDRESS_ID=replace-with-pickup-address-id
BOSTA_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---- EasyOrder webhook ----
# EasyOrder secret(s) are stored per sales channel in the database
# (sales_channels.webhookSecret), not as a global env var. See the
# `salesChannels` router/table if a channel-level secret needs rotating.
